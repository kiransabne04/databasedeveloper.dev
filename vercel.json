{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "databasedeveloper.dev" }],
      "destination": "https://walstack.io/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.databasedeveloper.dev" }],
      "destination": "https://walstack.io/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "databasedeveloper.dev" }],
      "destination": "https://walstack.io/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.databasedeveloper.dev" }],
      "destination": "https://walstack.io/:path*",
      "statusCode": 301
    },
    {
      "source": "/crack-sql-interviews-with-these-postgresql-internals-and-real-questions",
      "destination": "https://kiransabne.dev/cracking-the-sql-interview-real-questions-and-postgresql-internals-you-should-know",
      "permanent": true
    },
    {
      "source": "/archive",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/members",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/recommendations",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
