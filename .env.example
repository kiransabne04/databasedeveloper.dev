# Optional analytics.
PUBLIC_GA_ID=
PUBLIC_PLAUSIBLE_DOMAIN=

# Optional form endpoint (Formspree/Tally/custom endpoint).
# If empty, the contact page falls back to email.
PUBLIC_CONTACT_ENDPOINT=

# Optional public scheduling page for the 20-minute triage call
# (e.g. https://cal.com/<user>/triage or https://calendly.com/<user>/triage).
# Overrides the default in src/config/site.ts.
PUBLIC_BOOKING_URL=
