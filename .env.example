# Public 15-minute scheduling page. The default is Kiran's 15-minute Cal.com event.
PUBLIC_BOOKING_URL=https://cal.com/kiransabne13/15min

# Formspree form that receives general enquiries.
PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/maeqleqk
# Optional dedicated Formspree form with file uploads enabled. Defaults to the contact form.
PUBLIC_SNAPSHOT_ENDPOINT=

# Cookieless analytics on WalStack production hostnames. Empty domain disables it.
PUBLIC_PLAUSIBLE_DOMAIN=walstack.io
# Paste the site-specific script URL from Plausible. Defaults to its legacy domain script.
PUBLIC_PLAUSIBLE_SCRIPT_URL=
