---
import BaseLayout from './BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  published: string;
  updated: string;
  original?: boolean;
  ctaTitle?: string;
  ctaDescription?: string;
}

const { title, description, eyebrow, published, updated, original = false, ctaTitle, ctaDescription } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, site.url).toString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  mainEntityOfPage: pageUrl,
  author: { '@type': 'Person', name: site.personName, url: `${site.url}/about` },
  publisher: { '@type': 'Organization', name: site.brand, url: site.url },
  datePublished: published,
  dateModified: updated
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Guides', item: `${site.url}/insights` },
    { '@type': 'ListItem', position: 2, name: title, item: pageUrl }
  ]
};
---
<BaseLayout title={`${title} — DatabaseDeveloper`} description={description} schema={[articleSchema, breadcrumbSchema]} ogType="article" published={published} updated={updated}>
  <article>
    <header class="container article-header">
      <nav class="article-breadcrumb small muted" aria-label="Breadcrumb"><a href="/insights">Guides</a><span aria-hidden="true"> / </span><span aria-current="page">{title}</span></nav>
      <span class="eyebrow">{eyebrow}</span>
      <h1 class="article-title">{title}</h1>
      <p class="lede">{description}</p>
      <p class="small muted">By <a href="/about">{site.personName}</a> · Published <time datetime={published}>{published}</time> · Updated <time datetime={updated}>{updated}</time></p>
      {original && <p class="small muted">Technically reviewed and corrected on <time datetime={updated}>{updated}</time>, with added <a href="#production-notes">production notes</a>.</p>}
    </header>
    <section><div class="container prose article-body"><slot /></div></section>
  </article>
  <section><div class="container"><CTA title={ctaTitle ?? 'Need help with a production PostgreSQL problem?'} description={ctaDescription ?? 'Bring the symptom and available evidence. A scoped investigation turns competing hypotheses into a ranked validation plan.'} /></div></section>
</BaseLayout>
