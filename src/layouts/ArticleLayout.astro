---
import BaseLayout from './BaseLayout.astro';
import { site } from '../config/site';
import ConversionActions from '../components/ConversionActions.astro';
import { offers, nextStep, type OfferKey } from '../data/offers';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  published: string;
  updated: string;
  original?: boolean;
  ctaTitle?: string;
  ctaDescription?: string;
  /** Paid offer this guide leads to; drives the header line and closing panel. */
  offer?: OfferKey;
  /** Hide the header offer line where no offer matches the topic. */
  offerLine?: boolean;
  schemaType?: 'Article' | 'BlogPosting';
  /** Keep out of search results (links still followed); also list the path in astro.config.mjs `excluded`. */
  noindexFollow?: boolean;
  /** Questions answered in the article's FAQ section, as plain text, for FAQPage structured data. */
  faq?: { q: string; a: string }[];
}

const { title, description, eyebrow, published, updated, original = false, ctaTitle, ctaDescription, offer = 'investigation', offerLine = true, schemaType = 'BlogPosting', faq, noindexFollow = false } = Astro.props;
const details = offers[offer];
const step = nextStep(offer, Astro.url.pathname);

const pageUrl = new URL(Astro.url.pathname, site.url).toString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  headline: title,
  description,
  mainEntityOfPage: pageUrl,
  image: `${site.url}/og-default.png`,
  author: { '@type': 'Person', '@id': `${site.url}/#kiran`, name: site.personName, url: `${site.url}/about` },
  publisher: { '@type': 'Organization', '@id': `${site.url}/#practice`, name: site.brand, url: site.url, logo: `${site.url}/og-default.png` },
  datePublished: published,
  dateModified: updated
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Guides', item: `${site.url}/insights` },
    { '@type': 'ListItem', position: 2, name: title, item: pageUrl }
  ]
};
const faqSchema = faq?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } }))
} : undefined;
---
<BaseLayout title={`${title} — WalStack`} description={description} schema={faqSchema ? [articleSchema, breadcrumbSchema, faqSchema] : [articleSchema, breadcrumbSchema]} ogType="article" published={published} updated={updated} {noindexFollow}>
  <article>
    <header class="container article-header">
      <nav class="article-breadcrumb small muted" aria-label="Breadcrumb"><a href="/insights">Guides</a><span aria-hidden="true"> / </span><span aria-current="page">{title}</span></nav>
      <span class="eyebrow">{eyebrow}</span>
      <h1 class="article-title">{title}</h1>
      <p class="lede">{description}</p>
      <p class="small muted">By <a href="/about">{site.personName}</a> · Published <time datetime={published}>{published}</time> · Updated <time datetime={updated}>{updated}</time></p>
      {/lab/i.test(eyebrow) && <p class="small muted">I measured this example on generated data in a lab. It contains no client results.</p>}
      {offerLine && <p class="article-service small">Have a similar issue in production? <a href={step.href} data-track={step.track} data-offer={offer}>{step.label}</a> or <a href={site.bookingUrl} data-track="book_call_click" data-offer={offer}>book a 15-minute call</a>.</p>}
      {original && <p class="small muted">Technically reviewed and corrected on <time datetime={updated}>{updated}</time>, with added <a href="#production-notes">production notes</a>.</p>}
    </header>
    <section><div class="container prose article-body"><slot /></div></section>
  </article>
  <section>
    <div class="container">
      <div class="cta-panel article-close">
        <div>
          <span class="eyebrow">{details.name}</span>
          <h2>{ctaTitle ?? 'Need help with a production PostgreSQL problem?'}</h2>
          <p class="muted">{ctaDescription ?? 'Bring the symptom and available evidence. A scoped investigation turns competing hypotheses into a ranked validation plan.'}</p>
        </div>
        <ConversionActions offer={offer} />
      </div>
      <div class="author-box">
        <p><strong>About the author.</strong> I'm <a href="/about">{site.personName}</a>, an independent PostgreSQL performance consultant. I've spent about 8 years in database and backend engineering, about 6 of them with PostgreSQL in production on RDS and Aurora. These guides draw on my work and public <a href="https://github.com/kiransabne04/databasedeveloper.dev/tree/main/labs">labs</a> you can rerun. See <a href="/how-it-works">how a scoped engagement works</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
