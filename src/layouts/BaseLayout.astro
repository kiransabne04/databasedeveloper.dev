---
import '../styles/global.css';
import type { OfferKey } from '../data/offers';
import { site, nav } from '../config/site';

interface Props {
  serviceId?: OfferKey;
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  ogType?: 'website' | 'article';
  published?: string;
  updated?: string;
  noindex?: boolean;
  /** Keep out of the index but let crawlers follow its links (secondary-capability and legal pages). */
  noindexFollow?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = `PostgreSQL Performance Consulting for RDS & Aurora | ${site.brand}`,
  description = site.description,
  canonical,
  image = `${site.url}/og-default.png`,
  ogType = 'website',
  published,
  updated,
  noindex = false,
  noindexFollow = false,
  schema,
  serviceId
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).toString();
const isNotFound = Astro.url.pathname.replace(/\/$/, '') === '/404';
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': site.url + '/#practice',
    name: site.brand,
    url: site.url,
    description: site.description,
    email: site.email,
    founder: { '@id': site.url + '/#kiran' },
    image: `${site.url}/og-default.png`,
    address: { '@type': 'PostalAddress', addressCountry: 'IN' },
    areaServed: 'Worldwide',
    knowsAbout: ['PostgreSQL', 'Amazon RDS for PostgreSQL', 'Amazon Aurora PostgreSQL', 'SQL Server', 'pgvector', 'Snowflake']
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': site.url + '/#website',
    name: site.brand,
    alternateName: 'walstack.io',
    url: site.url,
    publisher: { '@id': site.url + '/#practice' }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': site.url + '/#kiran',
    name: site.personName,
    jobTitle: 'Independent PostgreSQL performance engineer',
    url: site.url + '/about',
    worksFor: { '@id': site.url + '/#practice' },
    sameAs: [site.linkedinUrl, site.githubUrl, site.personalSiteUrl]
  },
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="WalStack insights" href={`${site.url}/rss.xml`} />
    <link rel="alternate" type="application/rss+xml" title="PostgreSQL guides" href={`${site.url}/rss/postgresql.xml`} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {!noindex && noindexFollow && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.brand} />
    {ogType === 'article' && published && <meta property="article:published_time" content={published} />}
    {ogType === 'article' && updated && <meta property="article:modified_time" content={updated} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" content="#07100e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body data-not-found={isNotFound ? 'true' : undefined} data-service-id={serviceId} data-plausible-script={site.plausibleScript} data-analytics-hosts={JSON.stringify(site.analyticsHosts)} data-plausible-domain={site.plausibleDomain}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container nav-shell">
        <a class="brand" href="/" aria-label="WalStack home">
          <img src="/favicon.svg" alt="" width="34" height="34" />
          <span>{site.brand}</span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a class="nav-cta" data-track="book_call_click" href={site.bookingUrl}>Book a call</a>
        </nav>
        <details class="mobile-menu">
          <summary>Menu</summary>
          <div class="mobile-menu-panel">
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
            <a class="nav-cta" href={site.bookingUrl} data-track="book_call_click">Book a call</a>
          </div>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand" href="/">
            <img src="/favicon.svg" alt="" width="34" height="34" />
            <span>{site.brand}</span>
          </a>
          <p>Kiran Sabne · Independent PostgreSQL engineer<br />India · remote, worldwide</p>
          <p><a href="/snapshot" data-track="primary_cta_click">Get a free snapshot review</a> · <a href={site.bookingUrl} data-track="book_call_click">{site.callLabel}</a></p>
          <p class="small">© 2026 {site.legalName}</p>
        </div>
        <div class="footer-links">
          <div><strong>Work</strong>
            <a href="/postgresql-performance-investigation">Investigation</a>
            <a href="/postgresql-upgrade-readiness">Upgrade readiness</a>
            <a href="/query-rescue">Query Rescue</a>
            <a href="/database-code-review">Database Code Review</a>
            <a href="/aws-rds-aurora-postgresql">RDS &amp; Aurora</a>
            <a href="/capabilities">Capabilities</a>
            <a href="/partners">Partners</a>
          </div>
          <div><strong>Resources</strong>
            <a href="/problems">Problems</a><a href="/how-it-works">How it works</a><a href="/insights">Guides</a><a href="/case-studies">Case studies (lab)</a>
            <a href="/sample-report" data-track="sample_report_click">Sample report (demo)</a>
            <a href={site.planReaderUrl} data-track="planreader_click">PlanReader</a>
            <a href={site.extensionUrl}>pg_stat_index_queries</a><a href="/rss.xml">RSS</a>
          </div>
          <div><strong>Details</strong>
            <a href="/pricing">Pricing</a><a href="/about">About</a><a href="/contact">Contact</a>
            <a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/privacy#cookies">Cookie settings</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // @ts-nocheck
      import { resolveCampaignContext } from '../lib/campaign-context.mjs';
      import { createTracker, clickProps } from '../lib/analytics.mjs';
      const serviceId = document.body.dataset.serviceId || null;
      const analyticsHosts = JSON.parse(document.body.dataset.analyticsHosts || '[]');
      const domain = document.body.dataset.plausibleDomain;
      if (domain && analyticsHosts.includes(location.hostname)) {
        window.plausible = function() { (window.plausible.q = window.plausible.q || []).push(arguments); };
        const script = document.createElement('script');
        script.defer = true;
        if (document.body.dataset.plausibleScript) {
          script.src = document.body.dataset.plausibleScript;
          window.plausible.init = (options) => { window.plausible.o = options || {}; };
          window.plausible.init();
        } else {
          script.dataset.domain = domain;
          script.src = 'https://plausible.io/js/script.js';
        }
        document.head.appendChild(script);
      }

      // Keep first touch and the latest tagged visit separate within this tab.
      let storage;
      try { storage = window.sessionStorage; } catch { storage = null; }
      const { campaignContext } = resolveCampaignContext(location, document.referrer, storage);

      for (const field of document.querySelectorAll('form [data-campaign]')) {
        field.value = campaignContext[field.name] || '';
      }

      const track = createTracker({ getPlausible: () => window.plausible, location, campaignContext });

      document.addEventListener('click', (event) => {
        const element = event.target instanceof Element ? event.target : null;
        const target = element?.closest('[data-track]');
        if (target?.dataset.track) track(target.dataset.track, clickProps(target.dataset, serviceId));
        if (element?.closest('a[href^="mailto:"]')) track('email_click');
      });
      window.addEventListener('dd:track', (event) => {
        if (typeof event.detail === 'string') track(event.detail);
        else if (event.detail && typeof event.detail.name === 'string') track(event.detail.name, event.detail.props || {}, event.detail.callback);
      });
      if (serviceId) track('service_page_view', { service_id: serviceId });
      const path = location.pathname.replace(/\/$/, '') || '/';
      if (path === '/snapshot') track('snapshot_page_view');
      if (path === '/pricing') track('pricing_view');
      if (path === '/sample-report') track('sample_report_view');
      if (path === '/postgresql-performance-investigation') track('investigation_page_view');
      if (path === '/postgresql-upgrade-readiness') track('upgrade_page_view');
      if (['/sql-server-performance', '/pgvector-performance', '/snowflake-performance', '/olap-analytical-performance'].includes(path)) track('capability_page_view');
      if (document.body.dataset.notFound === 'true') track('page_not_found');
    </script>
  </body>
</html>
