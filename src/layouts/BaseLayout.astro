---
import '../styles/global.css';
import { site, nav } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  ogType?: 'website' | 'article';
  published?: string;
  updated?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = `${site.brand} — PostgreSQL Performance Investigation`,
  description = site.description,
  canonical,
  image = `${site.url}/og-default.png`,
  ogType = 'website',
  published,
  updated,
  noindex = false,
  schema
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).toString();
const gaEnabled = Boolean(site.gaId);
const isNotFound = Astro.url.pathname.replace(/\/$/, '') === '/404';
// Search results truncate titles around 60 characters; drop the brand suffix rather than the topic.
const brandSuffix = ` — ${site.brand}`;
const pageTitle = title.length > 60 && title.endsWith(brandSuffix) ? title.slice(0, -brandSuffix.length) : title;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: site.brand,
    url: site.url,
    description: site.description,
    email: site.email,
    founder: {
      '@type': 'Person',
      name: site.personName,
      url: `${site.url}/about`,
      sameAs: [site.linkedinUrl, site.githubUrl, site.personalSiteUrl]
    },
    areaServed: 'Worldwide',
    serviceType: [
      'PostgreSQL performance investigation',
      'PostgreSQL upgrade readiness',
      'SQL Server performance review',
      'pgvector performance review',
      'Snowflake query performance review'
    ]
  },
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="DatabaseDeveloper insights" href={`${site.url}/rss.xml`} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && published && <meta property="article:published_time" content={published} />}
    {ogType === 'article' && updated && <meta property="article:modified_time" content={updated} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" content="#07100e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body data-not-found={isNotFound ? 'true' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container nav-shell">
        <a class="brand" href="/" aria-label="DatabaseDeveloper home">
          <span class="brand-mark" aria-hidden="true">DD</span>
          <span>DatabaseDeveloper</span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href={site.planReaderUrl} data-track="planreader_click">PlanReader ↗</a>
          <a class="nav-cta" data-track="primary_cta_click" href="/contact">Request investigation</a>
        </nav>
        <details class="mobile-menu">
          <summary>Menu</summary>
          <div class="mobile-menu-panel">
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
            <a href={site.planReaderUrl} data-track="planreader_click">PlanReader ↗</a>
            <a href="/contact">Request investigation</a>
          </div>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">DD</span>
            <span>DatabaseDeveloper</span>
          </a>
          <p>Evidence-first database performance investigations by <a href="/about">{site.personName}</a>.</p>
          <p class="small">PostgreSQL first. Specialist capability across SQL Server, pgvector, Snowflake and analytical/OLAP workloads.</p>
        </div>
        <div class="footer-links">
          <div>
            <strong>Work</strong>
            <a href="/postgresql-performance-investigation">Investigation</a>
            <a href="/postgresql-upgrade-readiness">Upgrade readiness</a>
            <a href="/pricing">Pricing</a>
          </div>
          <div>
            <strong>Learn</strong>
            <a href="/problems">Problems</a>
            <a href="/case-studies">Case studies</a>
            <a href="/insights">Guides</a>
            <a href="/rss.xml">RSS</a>
          </div>
          <div>
            <strong>Connect</strong>
            <a href={site.planReaderUrl} data-track="planreader_click">PlanReader ↗</a>
            <a href={site.sqlServerBlogUrl} data-track="mssqlserver_click">MSSQLServer.dev ↗</a>
            <a href="/about">About Kiran</a>
            <a href="/contact">Contact</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
            {gaEnabled && <button type="button" class="link-button" data-consent-reset>Cookie settings</button>}
          </div>
        </div>
      </div>
    </footer>

    {gaEnabled && (
      <div id="consent-banner" class="consent-banner" role="region" aria-label="Analytics cookies" hidden>
        <p>This site uses Google Analytics cookies to understand which pages are useful, only if you accept. No advertising. <a href="/privacy">Privacy</a></p>
        <div class="actions">
          <button type="button" class="button" data-consent="denied">Decline</button>
          <button type="button" class="button primary" data-consent="granted">Accept analytics</button>
        </div>
      </div>
    )}

    <script is:inline define:vars={{ gaId: site.gaId, analyticsHosts: site.analyticsHosts, plausibleDomain: import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN }}>
      if (plausibleDomain) {
        const s = document.createElement('script');
        s.defer = true;
        s.dataset.domain = plausibleDomain;
        s.src = 'https://plausible.io/js/script.js';
        document.head.appendChild(s);
      }

      // Google Analytics loads only after the visitor accepts analytics cookies.
      const consentKey = 'dd-analytics-consent';
      function loadGoogleAnalytics() {
        if (window.gtag) return;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function(){ dataLayer.push(arguments); };
        gtag('consent', 'default', {
          analytics_storage: 'granted',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });
        gtag('js', new Date());
        gtag('config', gaId, { allow_google_signals: false, allow_ad_personalization_signals: false });
        const s = document.createElement('script');
        s.async = true;
        s.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
        document.head.appendChild(s);
      }
      function clearAnalyticsCookies() {
        document.cookie.split(';').map((c) => c.split('=')[0].trim()).filter((name) => name.startsWith('_ga')).forEach((name) => {
          const host = location.hostname.replace(/^www\./, '');
          document.cookie = `${name}=; Max-Age=0; path=/`;
          document.cookie = `${name}=; Max-Age=0; path=/; domain=.${host}`;
        });
      }
      if (gaId && analyticsHosts.includes(location.hostname)) {
        const banner = document.getElementById('consent-banner');
        const choice = localStorage.getItem(consentKey);
        if (choice === 'granted') loadGoogleAnalytics();
        else if (choice !== 'denied' && banner) banner.hidden = false;
        banner?.addEventListener('click', (event) => {
          const button = event.target instanceof Element ? event.target.closest('[data-consent]') : null;
          if (!button) return;
          const granted = button.getAttribute('data-consent') === 'granted';
          localStorage.setItem(consentKey, granted ? 'granted' : 'denied');
          banner.hidden = true;
          if (granted) loadGoogleAnalytics();
          else clearAnalyticsCookies();
        });
        document.querySelector('[data-consent-reset]')?.addEventListener('click', () => {
          if (localStorage.getItem(consentKey) === 'granted') {
            localStorage.removeItem(consentKey);
            clearAnalyticsCookies();
            location.reload();
            return;
          }
          localStorage.removeItem(consentKey);
          if (banner) banner.hidden = false;
        });
      }

      const campaign = new URLSearchParams(location.search).get('utm_campaign') || undefined;
      const source = new URLSearchParams(location.search).get('utm_source') || undefined;
      function track(name) {
        const props = { source_page: location.pathname, ...(source ? { utm_source: source } : {}), ...(campaign ? { utm_campaign: campaign } : {}) };
        if (window.plausible) window.plausible(name, { props });
        if (window.gtag) window.gtag('event', name, props);
      }

      document.addEventListener('click', (event) => {
        const element = event.target instanceof Element ? event.target : null;
        const target = element?.closest('[data-track]');
        if (target?.dataset.track) track(target.dataset.track);
        if (element?.closest('a[href^="mailto:"]')) track('email_click');
      });
      window.addEventListener('dd:track', (event) => {
        if (typeof event.detail === 'string') track(event.detail);
      });
      const path = location.pathname.replace(/\/$/, '') || '/';
      if (path === '/postgresql-performance-investigation') track('investigation_page_view');
      if (path === '/postgresql-upgrade-readiness') track('upgrade_page_view');
      if (['/sql-server-performance', '/pgvector-performance', '/snowflake-performance', '/olap-analytical-performance'].includes(path)) track('capability_page_view');
      if (document.body.dataset.notFound === 'true') track('page_not_found');
    </script>
  </body>
</html>
