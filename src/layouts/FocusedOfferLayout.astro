---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ConversionActions from '../components/ConversionActions.astro';
import { offers, contactHref, type FocusedOffer } from '../data/offers';
import { site } from '../config/site';
import ServiceFAQ from '../components/ServiceFAQ.astro';
import { servicePageSchema, type Faq } from '../lib/schema';

interface Props {
  service: FocusedOffer;
  title: string;
  description: string;
  headline: string;
  fit: string;
  excludes: string;
  eyebrow?: string;
  /** Visible H1; defaults to the offer name. */
  heading?: string;
  faq: Faq[];
}
const { service, title, description, headline, fit, excludes, eyebrow = 'PostgreSQL and SQL Server', heading, faq } = Astro.props;
const offer = offers[service];

const url = site.url + offer.href;
const schema = servicePageSchema({ name: heading ?? offer.name, path: offer.href, description, breadcrumb: heading ?? offer.name, faq });
---
<BaseLayout {title} {description} canonical={url} {schema} serviceId={service}>
  <PageHero {eyebrow} title={heading ?? offer.name} description={headline}
    primaryLabel={offer.askLabel} primaryHref={contactHref(service, offer.href)}
    secondaryLabel="See the written deliverables" secondaryHref="#deliverables" supportingText={offer.price}>
    <p class="muted">{fit}</p>
  </PageHero>
  <section><div class="container grid two">
    <div class="card"><h2>What to prepare</h2><slot name="inputs" /></div>
    <div class="card" id="deliverables"><h2>What you receive</h2><ul>{offer.receive.map(item => <li>{item}</li>)}</ul><slot name="result" /></div>
  </div></section>
  <section><div class="container prose"><slot /><ServiceFAQ items={faq} /></div></section>
  <section><div class="container cta-panel">
    <div><h2>Agree the scope before sharing evidence</h2><p>{offer.terms}. One written review and one clarification round. I confirm the fixed fee and delivery window before paid work begins.</p>
    <p class="muted">{excludes}</p></div>
    <ConversionActions offer={service} />
  </div></section>
</BaseLayout>
<style> #deliverables { scroll-margin-top: 6rem; } </style>
