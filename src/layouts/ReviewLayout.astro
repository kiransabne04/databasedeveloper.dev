---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { site } from '../config/site';
import { contactHref } from '../data/offers';
import { reviews, type ReviewKey } from '../data/reviews';

interface Props {
  service: ReviewKey;
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  headline: string;
  intro: string;
  trust: string;
  jumpLabel: string;
  jumpId: string;
  finalHeading: string;
  finalCopy: string;
  scope: string[];
  exclusions: string;
}

const { service, title, description, eyebrow, heading, headline, intro, trust, jumpLabel,
  jumpId, finalHeading, finalCopy, scope, exclusions } = Astro.props;
const review = reviews[service];
const url = site.url + review.href;
const ask = contactHref(service, review.href);
const crumbs = [
  { name: 'Home', item: site.url + '/' },
  { name: review.name, item: url },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: review.name,
    serviceType: heading, url, description, provider: { '@id': site.url + '/#practice' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((crumb, index) => ({ '@type': 'ListItem', position: index + 1, ...crumb })) },
];
---
<BaseLayout {title} {description} canonical={url} {schema} reviewKey={service}>
  <div class="review">
    <PageHero {eyebrow} title={heading} description={headline} primaryLabel={review.cta}
      primaryHref={ask} primaryTrack="service_cta_click" secondaryLabel={jumpLabel} secondaryHref={'#' + jumpId} supportingText={trust}>
      <p class="muted">{intro}</p>
      <nav slot="aside" class="hero-proof review-nav" aria-label="Review details">
        <a href="#coverage">Technical coverage</a>
        <a href="#deliverables">What you receive</a>
        <a href="#scope">Scope and pricing</a>
        <a href="#questions">Common questions</a>
      </nav>
    </PageHero>

    <slot />
    <section id="scope"><div class="container review-row">
      <h2>Scope and pricing</h2>
      <div class="card">
        <h3>{review.name}</h3>
        <ul>{scope.map(item => <li>{item}</li>)}</ul>
        <p><strong>{review.price || 'Fixed quote after scope confirmation.'}</strong> {review.turnaround || 'I confirm the fee and delivery window once I have the evidence and can schedule the work.'}</p>
        <p><strong>Outside this scope.</strong> {exclusions}</p>
        <p>If the work expands, I’ll identify the additional question and quote it separately before proceeding.</p>
      </div>
    </div></section>

    <slot name="evidence" />
    <section id="questions"><div class="container review-row"><h2>Common questions</h2>
      <div class="review-faq"><slot name="faq" /></div>
    </div></section>
    <section><div class="container">
      <CTA eyebrow={review.name} title={finalHeading} description={finalCopy} primaryLabel={review.cta} primaryHref={ask} primaryTrack="service_cta_click" />
      <p class="topic-nav related"><slot name="related" /></p>
    </div></section>
  </div>
</BaseLayout>

<style is:global>
  .review section[id] { scroll-margin-top: 4.5rem; }
  .review .hero-grid { align-items: center; }
  .review-nav { display: grid; padding: .45rem 1.35rem; }
  .review-nav a { padding: .75rem 0; }
  .review-nav a + a, .review-faq details + details { border-top: 1px solid var(--line); }
  .review-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 3rem; }
  .review-row h2 { font-size: clamp(1.55rem, 3vw, 2.3rem); }
  .review-row p, .review-row li, .review-row dd { color: var(--soft); }
  .review-row p:first-child, .review-row ul:first-child, .review-row ol:first-child { margin-top: 0; }
  .review-row a, .review .related a { color: var(--accent); text-decoration: underline; text-underline-offset: .2em; }
  .review-row code { overflow-wrap: anywhere; }
  .review-row li + li { margin-top: .35rem; }
  .review-row .card h3 { font-size: 1.2rem; }
  .review-row .grid { align-content: start; }
  .review-row details { padding: .95rem 0; }
  .review-row summary { cursor: pointer; font-weight: 700; }
  .review-row details p { margin: .65rem 0 0; }
  .review .related { margin: 1.5rem 0 0; }
  .review :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 800px) { .review-row { grid-template-columns: minmax(0, 1fr); gap: .75rem; } }
  @media (prefers-reduced-motion: reduce) {
    html:has(.review) { scroll-behavior: auto; }
    .review .button { transition: none; transform: none; }
  }
</style>
