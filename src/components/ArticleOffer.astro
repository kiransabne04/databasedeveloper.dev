---
import { site } from '../config/site';
import { offers, type OfferKey } from '../data/offers';

interface Props {
  offer: OfferKey;
  /** The production situation where help is worth paying for, in the reader's terms. */
  title: string;
  text: string;
}

const { offer, title, text } = Astro.props;
const details = offers[offer];

---
<aside class="article-offer" aria-label={`About the ${details.name}`}>
  <p class="article-offer-title"><strong>{title}</strong></p>
  <p>{text}</p>
  <p class="small">
    <a href="/snapshot" data-track="primary_cta_click">Get a free PostgreSQL snapshot review</a> · <a href={site.bookingUrl} data-track="book_call_click">Book a call</a>
  </p>
</aside>
