---
import { site } from '../config/site';
import { offers, nextStep, type OfferKey } from '../data/offers';

interface Props {
  offer: OfferKey;
  /** The production situation where help is worth paying for, in the reader's terms. */
  title: string;
  text: string;
}

const { offer, title, text } = Astro.props;
const details = offers[offer];
const step = nextStep(offer, Astro.url.pathname);
---
<aside class="article-offer" aria-label={`About the ${details.name}`}>
  <p class="article-offer-title"><strong>{title}</strong></p>
  <p>{text}</p>
  <p class="small">
    <a href={step.href} data-track={step.track} data-offer={offer}>{step.label}</a> · <a href={details.href}>About the {details.name}</a> · <a href={details.magnet.href} data-track={details.magnet.track}>{details.magnet.label}</a>
  </p>
</aside>
