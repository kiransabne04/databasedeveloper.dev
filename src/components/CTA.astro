---
import ConversionActions from './ConversionActions.astro';
const { eyebrow, title = 'Is production PostgreSQL slowing you down?', description = 'Send a snapshot. I’ll reply with three written findings within two business days.' } = Astro.props;
---
<div class="cta-panel"><div>{eyebrow && <span class="eyebrow">{eyebrow}</span>}<h2>{title}</h2><p>{description}</p></div><ConversionActions /></div>
