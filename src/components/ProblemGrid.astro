---
import { problems } from '../data/problems';
---
<div class="grid two">
  {problems.map((item) => (
    <a class="card card-link" href={item.href}>
      <span class="kicker">Problem guide</span>
      <h2 class="card-heading">{item.title}</h2>
      <p>{item.description}</p>
    </a>
  ))}
</div>
