---
import BaseLayout from '../layouts/BaseLayout.astro';
import { servicePageSchema, investigationOffers, type Faq } from '../lib/schema';
import ServiceFAQ from '../components/ServiceFAQ.astro';
import ExampleFinding from '../components/ExampleFinding.astro';

const description = 'Performance tuning and cost review for AWS RDS and Aurora PostgreSQL: high CPU, slow queries, connection pressure, RDS Proxy pinning and Aurora I/O cost, from Database Insights and CloudWatch evidence.';
const faq: Faq[] = [
  { q: 'Should I scale up the RDS instance or fix the queries?', a: 'Look at Database Insights load by SQL statement first. If a few statements account for most of the load, a bigger instance only buys time until data grows again. Scale up when the load is spread across the workload and the instance is at a real CPU, memory or I/O ceiling.' },
  { q: 'Can you work without access to my AWS account?', a: 'Yes. Your team exports Database Insights views, CloudWatch metrics and the parameter group, and runs a read-only SQL script. No AWS credentials or database write access are needed.' },
  { q: 'Does the review cover Aurora cost?', a: 'Yes, as far as the database workload drives it. On the Aurora Standard storage configuration, read and write I/O are billed per request, so scan-heavy statements show up on the bill. I identify which statements drive the I/O and whether the I/O-Optimized configuration is worth evaluating. I do not promise a savings figure.' },
  { q: 'Do I need Database Insights advanced mode?', a: 'No. Standard mode and pg_stat_statements are enough to start. Advanced mode adds longer history and execution plans, which helps when the slowdown started weeks ago.' },
  { q: 'Will RDS Proxy fix my connection problems?', a: 'Only if sessions are not pinned. Pinned sessions keep a backend connection each, which cancels the pooling. Check the DatabaseConnectionsCurrentlySessionPinned metric and the statements that cause pinning before relying on it.' }
];
import PageHero from '../components/PageHero.astro';
import PG14Notice from '../components/PG14Notice.astro';
import CTA from '../components/CTA.astro';
---
<BaseLayout title="AWS RDS & Aurora PostgreSQL Performance Tuning & Cost Optimization | WalStack" description={description} schema={servicePageSchema({ name: 'AWS RDS and Aurora PostgreSQL performance tuning', path: '/aws-rds-aurora-postgresql', description, breadcrumb: 'AWS RDS and Aurora PostgreSQL performance tuning', faq, offers: investigationOffers })}>
  <PageHero eyebrow="RDS and Aurora performance without defaulting to “scale the instance”" title="AWS RDS and Aurora PostgreSQL performance tuning and cost optimization" description="Use workload evidence to separate expensive statements, plan problems, connection amplification, waits and configuration from genuine capacity constraints." />
  <section>
    <div class="container grid three">
      <div class="card"><h2 class="card-heading">Workload concentration</h2><p>Which statements, calls and I/O patterns actually account for database time?</p></div>
      <div class="card"><h2 class="card-heading">Capacity vs inefficiency</h2><p>Distinguish a real resource ceiling from a workload that would simply consume the larger instance too.</p></div>
      <div class="card"><h2 class="card-heading">Upgrade/support risk</h2><p>Combine managed-service timelines with application and performance validation rather than treating upgrades as a checkbox.</p></div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Evidence</span><h2>What AWS already records, and what each source answers.</h2></div>
        <p>Most RDS and Aurora teams already have the evidence. It is spread across consoles and rarely lined up on the same timeline.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Source</th><th>What it answers</th></tr></thead>
          <tbody>
            <tr><td>CloudWatch Database Insights (formerly Performance Insights)</td><td>Database load by wait event and by SQL statement over time. Shows whether the instance is busy on CPU, I/O, locks or client waits, and which statements drive it. Advanced mode adds execution plans and lock analysis.</td></tr>
            <tr><td><code>pg_stat_statements</code></td><td>Total time, calls, rows and buffer use per normalized statement. Ranks the workload by total cost instead of by the slowest single query.</td></tr>
            <tr><td>CloudWatch instance metrics</td><td>CPU, freeable memory, read/write IOPS and latency, disk queue depth, connections and replica lag. On burstable classes and gp2 storage, CPU credit and burst balance show whether the ceiling is real or a credit drain.</td></tr>
            <tr><td>Enhanced Monitoring</td><td>OS-level view at up to one-second granularity: per-process CPU and memory, load and swap. This separates PostgreSQL work from the operating system and AWS agents.</td></tr>
            <tr><td>Parameter group and <code>pg_settings</code></td><td>Non-default settings and what changed. For example <code>work_mem</code>, autovacuum thresholds, <code>random_page_cost</code>, <code>max_connections</code> and logging settings.</td></tr>
            <tr><td>PostgreSQL logs (exported to CloudWatch Logs)</td><td>Slow statements via <code>log_min_duration_statement</code>, plans via <code>auto_explain</code>, lock waits via <code>log_lock_waits</code>, checkpoints and autovacuum activity.</td></tr>
            <tr><td>RDS Proxy metrics, if used</td><td>Client and database connection counts, and sessions pinned to a backend connection. Pinning can quietly cancel the pooling you are paying for.</td></tr>
            <tr><td>RDS events</td><td>Failovers, maintenance, minor-version upgrades, parameter changes and storage scaling. Use them to line up a regression with what changed.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="small muted">All of this is read-only. Your team exports it; no credentials or production write access are needed.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Common patterns</span><h2>Where RDS and Aurora performance problems usually hide.</h2></div>
      </div>
      <div class="grid two">
        <div class="card"><h3>High CPU, and a “scale up” that only buys time</h3><p>CPU climbs and the instance class goes up a size. Database Insights still shows the same three statements dominating load, so the bigger instance fills again as data grows.</p></div>
        <div class="card"><h3>Connection pressure and RDS Proxy pinning</h3><p>Connection counts spike after a deploy or a retry storm. Each query is fast; there are just too many backends competing. Pool sizing, RDS Proxy pinning and idle-in-transaction sessions matter more than indexes.</p></div>
        <div class="card"><h3>Storage and I/O limits</h3><p>Latency rises with disk queue depth while CPU looks fine. Check provisioned IOPS and throughput, burst balance, and whether the working set still fits in memory.</p></div>
        <div class="card"><h3>Aurora I/O and cost surprises</h3><p>On Aurora, read and write I/O is part of the bill on the Standard storage configuration. Scan-heavy workloads can show up in cost before they show up in latency.</p></div>
      </div>
    </div>
  </section>

  <section><div class="container prose">
    <h2>Worked example</h2>
    <ExampleFinding label="An illustrative pattern on RDS. No client data and no measured figures."
      symptom="CPU on the writer climbs to its ceiling after a release, and the proposal is to move up one instance size."
      cause="Database Insights shows most load from one statement that the release started calling once per item in a list. pg_stat_statements shows its calls multiplied while its mean time stayed flat."
      fix={`-- Confirm the call growth, then fix the access pattern in the application
SELECT queryid, calls, mean_exec_time, total_exec_time
FROM pg_stat_statements
ORDER BY total_exec_time DESC
LIMIT 10;`}
      lockRisk="The diagnosis is read-only. The fix is an application change that batches the lookups, so no database lock is involved. If an index is also added, CREATE INDEX CONCURRENTLY avoids blocking writes."
      validation="Database Insights load for that statement and the writer's CPU return to the pre-release level at the same traffic, without changing the instance class." />
    <p>The <a href="/postgresql-performance-investigation">PostgreSQL performance tuning and slowdown audit</a> applies this method to your own RDS or Aurora evidence.</p>
    <ServiceFAQ items={faq} />
  </div></section>

  <section>
    <div class="container"><PG14Notice /></div>
  </section>

  <section><div class="container"><CTA /></div></section>
</BaseLayout>
