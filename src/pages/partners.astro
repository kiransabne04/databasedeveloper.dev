---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---
<BaseLayout title="PostgreSQL Reviews for Agencies and Fractional CTOs | WalStack" description="Bring me a client with slow PostgreSQL. I’ll do the first review free under your name, so you can see the work before deciding anything.">
  <header class="container hero"><p class="eyebrow">For agencies and fractional CTOs</p>
    <h1>Bring me a client whose Postgres is slow.</h1>
    <p class="lede">I'll do the first review free, under your name, so you can see the work before deciding anything.</p>
    <p>You keep the client relationship. I review the read-only output you have permission to share and write up what stands out.</p>
    <div class="actions"><a class="button primary" href={site.bookingUrl} data-track="book_call_click">Book a call</a><a class="button" href="/snapshot">Get a free snapshot review</a></div>
  </header>
</BaseLayout>
