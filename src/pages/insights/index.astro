---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { site } from '../../config/site';

const groups = [
  {
    id: 'postgresql-performance',
    title: 'PostgreSQL performance and locking',
    intro: 'Diagnose blocking, indexing and physical-design problems from production evidence before changing the schema.',
    related: { label: 'PostgreSQL performance investigation', href: '/postgresql-performance-investigation' },
    items: [
      { href: '/insights/how-to-profile-slow-postgresql-queries', kicker: 'Method · New', title: 'How to profile slow PostgreSQL queries', text: 'pg_stat_statements to rank, auto_explain to capture the real plan, EXPLAIN ANALYZE to measure, then validate.' },
      { href: '/insights/postgresql-slow-queries-pg-stat-statements', kicker: 'Lab-tested', title: 'Find slow queries with pg_stat_statements', text: 'Rank statements by total time, diff snapshots and read buffer and temp signals before changing anything.' },
      { href: '/postgresql-concurrency-and-locking-a-comprehensive-guide', kicker: 'Locking', title: 'PostgreSQL concurrency and locking', text: 'Lock modes, advisory locks and deadlocks, plus how to find the session at the head of a blocking chain.' },
      { href: '/postgresql-indexing-when-brin-beats-b-tree', kicker: 'Indexing', title: 'When BRIN beats B-tree', text: 'Compare physical correlation, lossy rechecks and ordered access on the real query.' },
      { href: '/how-to-scale-postgresql-databases-with-partitioning', kicker: 'Partitioning', title: 'Scaling with partitioning', text: 'Range, list and hash partitioning; pruning, retention and key constraints before migrating a table.' },
      { href: '/mastering-clustering-in-postgresql-for-enhanced-query-performance', kicker: 'Physical design', title: 'CLUSTER and query performance', text: 'Measure heap locality against rewrite time, disk space and the ACCESS EXCLUSIVE lock.' },
      { href: '/sharding-postgresql-techniques-for-horizontal-scalability', kicker: 'Architecture', title: 'Sharding PostgreSQL', text: 'FDW and Citus approaches, shard keys, rebalancing and cross-shard work.' },
      { href: '/insights/what-ai-misses-postgresql', kicker: 'Diagnosis', title: 'What AI misses in production diagnosis', text: 'Why a plausible query recommendation can still be unsafe without workload context.' }
    ]
  },
  {
    id: 'upgrades',
    title: 'PostgreSQL upgrades and support dates',
    intro: 'Version deadlines on RDS, Aurora and community PostgreSQL, and how to plan an upgrade that does not regress performance.',
    related: { label: 'PostgreSQL upgrade readiness', href: '/postgresql-upgrade-readiness' },
    items: [
      { href: '/postgresql-14-upgrade-checklist', kicker: 'Checklist · New', title: 'PostgreSQL 14 upgrade checklist', text: 'Inventory, blockers, baseline, rehearsal, cutover and validation for RDS, Aurora and self-managed PG14.' },
      { href: '/insights/pg-upgrade-check-failures', kicker: 'Lab-tested · New', title: 'pg_upgrade --check failures and fixes', text: 'Real PG14 to PG18 output: checksum mismatch, prepared transactions and reg* columns, and what the check misses.' },
      { href: '/insights/postgresql-upgrade-logical-replication-slots', kicker: 'Lab-tested · New', title: 'pg_upgrade from 14 drops logical replication slots', text: 'The check passed with a CDC slot present; after the upgrade it was gone. RDS and Aurora block instead.' },
      { href: '/insights/rds-aurora-postgresql-14-to-18-blue-green', kicker: 'RDS · Aurora', title: 'RDS and Aurora 14 to 18: downtime and Blue/Green', text: 'In-place versus Blue/Green, and the logical replication limits that invalidate a green environment.' },
      { href: '/insights/postgresql-slow-after-major-upgrade', kicker: 'Lab-tested', title: 'Slow after a major upgrade? Check statistics first', text: 'A PG14 to PG17 pg_upgrade lost optimizer statistics and a join went from 222 ms to 904 ms.' },
      { href: '/insights/postgresql-14-minor-version-deadlines', kicker: 'RDS · Oct 2026', title: 'RDS PostgreSQL 14.18/14.19 lose standard support on 31 October', text: 'Minor-version deadlines that arrive before the PG14 major-version dates, and how to check your instances.' },
      { href: '/postgresql-14-eol', kicker: 'End of life', title: 'PostgreSQL 14 EOL planning', text: 'Current dates and the upgrade-readiness sequence.' }
    ]
  },
  {
    id: 'pgvector',
    title: 'pgvector and vector search',
    intro: 'Recall, latency, filtering and memory trade-offs when vector search runs inside PostgreSQL.',
    related: { label: 'pgvector performance review', href: '/pgvector-performance' },
    items: [
      { href: '/insights/pgvector-filtered-search-missing-results', kicker: 'Lab-tested · New', title: 'Filtered vector search returns too few rows', text: 'Why HNSW plus a WHERE filter returned 0 of 10 rows, and measured fixes from iterative scans to partial indexes.' },
      { href: '/insights/pgvector-hnsw-vs-ivfflat', kicker: 'Indexing', title: 'HNSW vs IVFFlat is a workload decision', text: 'Recall, latency, memory, build cost and filtering trade-offs.' },
      { href: '/building-a-semantic-similarity-search-api-with-fastapi-sentence-bert-and-postgresql-pgvector', kicker: 'Architecture', title: 'Semantic search API with FastAPI and pgvector', text: 'From a FastAPI demo to measured recall, tenant filtering and latency.' }
    ]
  },
  {
    id: 'other-databases',
    title: 'Other databases',
    intro: 'Concurrency and performance guides beyond PostgreSQL. SQL Server, Snowflake and analytical workloads are covered on their capability pages.',
    related: { label: 'All capabilities', href: '/capabilities' },
    items: [
      { href: '/insights/sql-server-parameter-sniffing-query-store', kicker: 'SQL Server · Lab-tested', title: 'SQL Server parameter sniffing', text: 'One cached plan read 9 pages for one customer and 900,524 for another. Query Store diagnosis and measured fixes.' },
      { href: 'https://mssqlserver.dev', kicker: 'SQL Server · MSSQLServer.dev ↗', title: 'SQL Server tutorials', text: 'Window functions, CTEs, isolation levels, row versioning, temporal tables and change tracking, on Kiran\'s SQL Server blog.' },
      { href: '/mastering-mongodb-locking-concurrency-and-performance-optimization-a-deep-dive', kicker: 'MongoDB', title: 'MongoDB locking and concurrency', text: 'WiredTiger lock modes, versioning, expiring lock fields and transaction retries.' },
      { href: '/sql-server-performance', kicker: 'SQL Server', title: 'SQL Server performance review', text: 'Query Store, plan regressions, blocking chains and ORM implicit conversions.' },
      { href: '/snowflake-performance', kicker: 'Snowflake', title: 'Snowflake performance and cost', text: 'Query history, warehouse sizing, pruning, spills and workload isolation.' }
    ]
  }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'PostgreSQL and database performance guides',
  url: `${site.url}/insights`,
  hasPart: groups.flatMap((group) => group.items.filter((item) => item.href.startsWith('/')).map((item) => ({ '@type': 'WebPage', name: item.title, url: `${site.url}${item.href}` })))
};
---
<BaseLayout title="PostgreSQL Performance Guides — DatabaseDeveloper" description="Practical guides to PostgreSQL locking, indexing, partitioning, upgrades and pgvector, grounded in production evidence and safe-change judgment." schema={schema}>
  <PageHero eyebrow="Guides" title="Database performance guides grounded in workload decisions." description="Use these guides to frame the evidence and trade-offs behind a production change. Each one ends with the checks to run on your own system." />
  {groups.map((group, groupIndex) => (
    <section id={group.id}><div class="container">
      {groupIndex === 0 && <nav class="topic-nav small" aria-label="Guide topics">Topics: {groups.map((item, index) => (<>{index > 0 && ' · '}<a href={`#${item.id}`}>{item.title}</a></>))}</nav>}
      <div class="section-head"><div><h2>{group.title}</h2></div><p>{group.intro} Related: <a href={group.related.href}>{group.related.label}</a>.</p></div>
      <div class="grid three">
        {group.items.map((item) => (
          <a class="card card-link" href={item.href} data-track={item.href.startsWith('/') ? undefined : 'mssqlserver_click'}><span class="kicker">{item.kicker}</span><h3>{item.title}</h3><p>{item.text}</p></a>
        ))}
      </div>
    </div></section>
  ))}
</BaseLayout>
