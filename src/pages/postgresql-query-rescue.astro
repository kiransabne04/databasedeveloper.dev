---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="PostgreSQL Query Review | WalStack"
  description="WalStack Query Rescue is available for PostgreSQL and SQL Server. Review the scope and request a fit review."
  canonical="https://walstack.io/query-rescue" noindex>
  <section><div class="container prose">
    <h1>PostgreSQL query review</h1>
    <p>Query Rescue now covers one SQL query and its relevant execution context for PostgreSQL or SQL Server.</p>
    <p><a class="button primary" data-track="service_cta_click" href="/query-rescue">See Query Rescue and its scope</a></p>
  </div></section>
</BaseLayout>
