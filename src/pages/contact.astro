---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../config/site';
const endpoint = site.contactEndpoint;
const action = endpoint || `mailto:${site.email}`;
---
<BaseLayout title="Contact WalStack | Investigation, Upgrade or Partnership" description="Tell WalStack about a PostgreSQL problem, planned upgrade or technical partnership. Agree on scope before paid work.">
  <PageHero eyebrow="Contact" title="Tell me what decision your team needs to make." description="Describe the symptom, upgrade or partner opportunity. I will review fit and scope before any paid work." primaryLabel="Start an inquiry" primaryHref="#inquiry-form" secondaryLabel="See Sample Report" secondaryHref="/sample-report" />
  <section>
    <div class="container grid two">
      <form id="inquiry-form" class="card" action={action} method="POST" enctype={endpoint ? undefined : "text/plain"} data-email={site.email} data-mailto-fallback={endpoint ? "false" : "true"}>
        <input type="hidden" name="utm_source" />
        <input type="hidden" name="utm_medium" />
        <input type="hidden" name="utm_campaign" />
        <input type="hidden" name="landing_page" />
        <input type="hidden" name="from_page" />
        {endpoint && (
          <>
            <input type="hidden" name="_subject" value="Database investigation request" />
            <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          </>
        )}
        <div class="form-grid">
          <div class="field full"><label for="offer">What are you asking about?</label><select id="offer" name="offer" required><option value="">Choose an option</option><option value="investigation">PostgreSQL Performance Investigation</option><option value="upgrade">PostgreSQL Upgrade Readiness Review</option><option value="sprint">Remediation or migration validation sprint</option><option value="partnership">Technical partnership</option><option value="pgvector">pgvector review</option><option value="sqlserver">SQL Server review</option><option value="snowflake">Snowflake review</option><option value="other">Other or legacy inquiry</option></select></div>
          <div class="field"><label for="name">Name</label><input id="name" name="name" required autocomplete="name" /></div>
          <div class="field"><label for="email">Email</label><input id="email" type="email" name="email" required autocomplete="email" /></div>
          <div class="field full"><label for="problem">What is happening or what collaboration do you have in mind?</label><textarea id="problem" name="problem" required minlength="20" placeholder="The decision, business impact, and evidence or context available"></textarea></div>
          <details class="field full optional-fields">
            <summary>Add platform, impact or evidence (optional)</summary>
            <div class="form-grid">
              <div class="field"><label for="database">Database / platform</label><select id="database" name="database"><option value="">Select if known</option><option>PostgreSQL</option><option>AWS RDS PostgreSQL</option><option>Aurora PostgreSQL</option><option>SQL Server</option><option>pgvector</option><option>Snowflake</option><option>OLAP / analytical</option><option>Other</option></select></div>
              <div class="field"><label for="version">Version</label><input id="version" name="version" placeholder="e.g. PostgreSQL 14.24" /></div>
              <div class="field full"><label for="evidence">Evidence available</label><input id="evidence" name="evidence" placeholder="pg_stat_statements, plans, Query Store, logs…" /></div>
              <div class="field"><label for="impact">Production impact</label><input id="impact" name="impact" placeholder="e.g. p95 latency or rising cost" /></div>
              <div class="field"><label for="timeline">Desired timeline</label><input id="timeline" name="timeline" placeholder="e.g. within 2 weeks" /></div>
            </div>
          </details>
        </div>
        <div class="actions"><button class="button primary" type="submit">{endpoint ? 'Send investigation request' : 'Open email draft'}</button></div>
        {!endpoint && <p class="small muted">Your email app will open with these details filled in. Review and send the draft there.</p>}
        <p class="small muted">I review inquiries personally and will respond by email if the work is a fit.</p>
        <p id="form-status" class="small" role="status" aria-live="polite" tabindex="-1"></p>
      </form>

      <aside class="card">
        {site.bookingUrl && (
          <>
            <span class="kicker">Prefer a call?</span>
            <h3>Book a {site.triageCallMinutes}-minute triage call</h3>
            <p class="muted">Pick a time that suits you. The call covers what is happening, what evidence exists and whether a fixed-scope review fits. It is not a free diagnosis.</p>
            <div class="actions"><a class="button primary" href={site.bookingUrl} target="_blank" rel="noopener" data-track="booking_click">Choose a time</a></div>
            <hr />
          </>
        )}
        <span class="kicker">Before sending</span>
        <h3>Useful context if you have it</h3>
        <ul class="muted">
          <li>Database/version and hosting platform</li>
          <li>What changed or when the symptom started</li>
          <li>Business impact</li>
          <li>What your team already tried</li>
          <li>What evidence can be exported safely</li>
        </ul>
        <p class="muted">Used PlanReader? Mention the finding that prompted your request and whether it affects production. You can review and redact any plan or other evidence before sharing it separately.</p>
        <p class="notice"><strong>Do not send credentials, production dumps or confidential customer data through this form.</strong></p>
        <p class="muted">The work is async-first. Calls fit US East mornings and EU afternoons.</p>
        <p>Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </aside>
    </div>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>('#inquiry-form');
    if (form) {
      try {
        const context = JSON.parse(sessionStorage.getItem('dd-campaign-context') || '{}');
        for (const key of ['utm_source', 'utm_medium', 'utm_campaign', 'landing_page']) {
          const input = form.elements.namedItem(key);
          if (input instanceof HTMLInputElement && typeof context[key] === 'string') input.value = context[key];
        }
      } catch { /* Contact still works when session storage is unavailable. */ }
      // Guides link here with ?offer=…&from=… so the inquiry shows which page produced it.
      const params = new URLSearchParams(location.search);
      const offer = (params.get('offer') || '').slice(0, 40);
      let fromPage = (params.get('from') || '').slice(0, 200);
      if (!fromPage.startsWith('/') && document.referrer) {
        try {
          const referrer = new URL(document.referrer);
          if (referrer.origin === location.origin && referrer.pathname !== location.pathname) {
            fromPage = referrer.pathname.slice(0, 200);
          }
        } catch { /* A missing or invalid referrer does not block the form. */ }
      }
      const offerInput = form.elements.namedItem('offer');
      const fromInput = form.elements.namedItem('from_page');
      if (offerInput instanceof HTMLSelectElement && [...offerInput.options].some((option) => option.value === offer)) offerInput.value = offer;
      if (fromInput instanceof HTMLInputElement && fromPage.startsWith('/')) fromInput.value = fromPage;
      const database = form.elements.namedItem('database');
      const platformForOffer: Record<string, string> = { pgvector: 'pgvector', sqlserver: 'SQL Server', snowflake: 'Snowflake' };
      if (database instanceof HTMLSelectElement && platformForOffer[offer]) database.value = platformForOffer[offer];
      let started = false;
      form.addEventListener('focusin', () => {
        if (!started) {
          window.dispatchEvent(new CustomEvent('dd:track', { detail: 'contact_start' }));
          started = true;
        }
      });
      form.addEventListener('submit', (event) => {
        if (!form.reportValidity()) return;
        if (form.dataset.mailtoFallback !== 'true') {
          event.preventDefault();
          const status = form.querySelector<HTMLElement>('#form-status');
          const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          if (button) button.disabled = true;
          if (status) status.textContent = 'Sending…';
          fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
            .then((response) => {
              if (!response.ok) throw new Error(String(response.status));
              const selectedOffer = offerInput instanceof HTMLSelectElement ? offerInput.value : '';
              window.dispatchEvent(new CustomEvent('dd:track', { detail: { name: 'contact_submit', props: { offer: selectedOffer, from_page: fromPage.startsWith('/') ? fromPage : undefined } } }));
              form.reset();
              if (status) { status.textContent = 'Thanks. Your inquiry was sent. I will review it and respond by email if there is a fit.'; status.focus(); }
            })
            .catch((error) => {
              if (status) { status.textContent = error.message === '429' ? `Too many requests. Please wait and retry, or email ${form.dataset.email}.` : `Sending failed. Please email ${form.dataset.email} directly.`; status.focus(); }
            })
            .finally(() => { if (button) button.disabled = false; });
          return;
        }
        event.preventDefault();
        window.dispatchEvent(new CustomEvent('dd:track', { detail: 'contact_draft_open' }));
        const fields = new FormData(form);
        const labels: Record<string, string> = {
          name: 'Name', email: 'Email', database: 'Database / platform', version: 'Version',
          problem: 'Problem', evidence: 'Evidence available', impact: 'Production impact', timeline: 'Desired timeline',
          utm_source: 'Source', utm_medium: 'Medium', utm_campaign: 'Campaign', landing_page: 'Landing page',
          offer: 'Offer', from_page: 'Came from'
        };
        const body = Object.entries(labels)
          .filter(([key]) => String(fields.get(key) ?? '').trim())
          .map(([key, label]) => `${label}: ${String(fields.get(key)).trim()}`)
          .join('\n');
        const subject = encodeURIComponent('WalStack inquiry');
        const message = encodeURIComponent(body);
        window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${message}`;
      });
    }
  </script>
</BaseLayout>
