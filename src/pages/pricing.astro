---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConversionActions from '../components/ConversionActions.astro';
import InvestigationDeliverables from '../components/InvestigationDeliverables.astro';
import { site } from '../config/site';
---
<BaseLayout title="PostgreSQL Review Pricing | WalStack" description="Start with a free snapshot. A slowdown investigation costs $450 for my first 3 clients, then $750. See upgrade pricing and exactly what each review includes.">
  <header class="container hero"><h1>PostgreSQL review pricing</h1><p class="lede">Start with three written findings for free. If you need a deeper answer, here’s what it costs in USD.</p></header>
  <section><div class="container">
    <div class="table-wrap pricing-table"><table><caption class="visually-hidden">PostgreSQL review prices in USD</caption><thead><tr><th scope="col">Review</th><th scope="col">Price</th><th scope="col">What you get</th></tr></thead><tbody>
      <tr><th scope="row"><a href="/snapshot">Free snapshot review</a></th><td>$0</td><td>3 written findings within 2 business days from one read-only script. I review 10 per month.</td></tr>
      <tr><th scope="row"><a href="/postgresql-performance-investigation">Postgres Slowdown Investigation</a></th><td>{site.investigationOffer.display}</td><td>The cause, a safe fix, a review call and a 14-day check. Full refund if I find no evidence-backed improvement.</td></tr>
      <tr><th scope="row"><a href="/postgresql-upgrade-readiness">PostgreSQL Upgrade Readiness</a></th><td>{site.upgradeOffer.display}</td><td>Pre-upgrade checks, current query timings, a comparison plan and a rollback plan.</td></tr>
    </tbody></table></div>
    <p>After an investigation, you can ask me about a monthly check-in.</p>
    <div class="prose"><h2>Inside the slowdown investigation</h2><InvestigationDeliverables />
    <p>I invoice upfront and deliver the report in 3 business days after I get access or your script output.</p><ConversionActions /></div>
  </div></section>
</BaseLayout>
